{
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "composite": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["esnext", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@iboutsikas/coverpage": ["packages/coverpage/src/index.ts"],
      "@iboutsikas/router": ["packages/router/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "out-tsc"]
}
