{
  "name": "@iboutsikas/site",
  "implicitDependencies": ["@iboutsikas/coverpage", "@iboutsikas/router"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": true,
        "commands": [
          "npm exec nx run @iboutsikas/coverpage:build:watch",
          "npm exec nx run @iboutsikas/router:build:watch",
          "cd apps/hugo-site && hugo server --bind 0.0.0.0"
        ],
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": "@iboutsikas/coverpage", "target": "build" },
        { "projects": "@iboutsikas/router", "target": "build" }
      ],
      "options": {
        "command": "hugo",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/public"]
    }
  }
}
